ter;\"><img src=\"imgs/img_in_image_box_243_1189_328_1278.jpg\" alt=\"Image\" width=\"7%\" /></div>\n","images":{"imgs/img_in_image_box_243_772_312_874.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//7224cde5-5062-4a2a-b420-2b7fc18b7c8f/markdown_0/imgs/img_in_image_box_243_772_312_874.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-08T13%3A45%3A04Z%2F-1%2F%2F01e2504ce832eb33981728fb9c265c0ceb5b50cf5dc8bb1cb9fba1c3fc7f16fb","imgs/img_in_image_box_245_1092_304_1185.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//7224cde5-5062-4a2a-b420-2b7fc18b7c8f/markdown_0/imgs/img_in_image_box_245_1092_304_1185.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-08T13%3A45%3A04Z%2F-1%2F%2Ff1a1581f139dab431053fece6de256f6d031a8654e8de8a4d8fb3e42b188dec9","imgs/img_in_image_box_243_1189_328_1278.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//7224cde5-5062-4a2a-b420-2b7fc18b7c8f/markdown_0/imgs/img_in_image_box_243_1189_328_1278.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-08T13%3A45%3A04Z%2F-1%2F%2Fd660090b010de473f91c83f8743571b5e7a552ad7883f4c48cb748fcf9a55079"}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//7224cde5-5062-4a2a-b420-2b7fc18b7c8f/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-08T13%3A45%3A05Z%2F-1%2F%2F354c59f9ca2358e10c8ae8bc79b36ce6607ffb16183d143fd2588c86b370e3f5"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//7224cde5-5062-4a2a-b420-2b7fc18b7c8f/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-08T13%3A45%3A05Z%2F-1%2F%2F784853676be8a7eed221c2e9061d33ba8a5d0f36df6695361bf00d8247d85ba6"}]