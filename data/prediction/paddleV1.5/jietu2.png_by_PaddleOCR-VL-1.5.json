[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"先看器形，此盉整體呈橢方形，侈口長頸，圓肩鼓腹，頸部長度不及腹部深，襠部微分，襠綫較低；肩一側設有斜出管狀流，流口與流根的粗細差異較小；與流對應的一側有獸首半環形鋬；四條柱足上粗下細；蓋面隆起，中部有半環形環鈕，一側有小鈕用鏈條與鋬相連。如1986年北京房山琉璃河西周墓出土克盉（《銘圖》14789），此器年代屬西周早期早段；1967年9月甘肅靈臺百草坡1號西周墓出土穰盉（又稱涉遽盉，《集成》9406），腹部分檔更為明顯，年代屬西周早期晚段。李雲朋先生在《商周青銅盉整理與研究》中將其歸入乙Bb型Ⅱ、Ⅲ式 $ ^{[3]} $。傳為山東壽張縣梁山下出土的伯憲盉（《集成》9430）也為淺分檔，四條柱足，時代約為西周早期偏晚，朱鳳瀚先生在《中國青銅器綜論》中將此器劃為腹身近鬲形的B型Ⅱ式 $ ^{[4]} $（以上三器見圖2）。","block_bbox":[1,19,1585,456],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[1.0,19.0],[1585.0,19.0],[1585.0,456.0],[1.0,456.0]]},{"block_label":"text","block_content":"再看紋飾，蓋面與腹部均對稱飾有尖喙垂冠長尾大鳥紋，尾羽翻卷至地，此種紋飾流行於西周早期偏晚至中期偏早（昭穆時期） $ ^{[5]} $。頸部飾長鳥紋，流管飾三角雲雷紋，足部飾陰線蟬紋。","block_bbox":[18,475,1584,589],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[18.0,475.0],[1584.0,475.0],[1584.0,589.0],[18.0,589.0]]},{"block_label":"text","block_content":"據其形制與紋飾，此盃具有西周早中交際時期的明顯特徵，該器的年代當斷在昭王晚期至穆王早期這段時間內。","block_bbox":[65,609,1522,648],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[65.0,609.0],[1522.0,609.0],[1522.0,648.0],[65.0,648.0]]},{"block_label":"text","block_content":"圖1：","block_bbox":[106,717,163,748],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[106.0,717.0],[163.0,717.0],[163.0,748.0],[106.0,748.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_107_808_566_1346.jpg\" alt=\"Image\" width=\"28%\" /></div>\n","block_bbox":[107,808,566,1346],"block_id":4,"group_id":4,"block_polygon_points":[[107.0,808.0],[566.0,808.0],[566.0,1346.0],[107.0,1346.0]