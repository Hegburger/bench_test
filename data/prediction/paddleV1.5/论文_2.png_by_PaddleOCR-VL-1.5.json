[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"header_image","block_content":"","block_bbox":[752,15,784,47],"block_id":0,"group_id":0,"block_polygon_points":[[752.0,15.0],[783.0,15.0],[783.0,46.0],[752.0,46.0]]},{"block_label":"header","block_content":"象外摹神","block_bbox":[1164,180,1233,203],"block_id":1,"group_id":1,"block_polygon_points":[[1164.0,180.0],[1232.0,180.0],[1232.0,202.0],[1164.0,202.0]]},{"block_label":"number","block_content":"077","block_bbox":[1263,177,1301,200],"block_id":2,"group_id":2,"block_polygon_points":[[1263.0,177.0],[1300.0,177.0],[1300.0,199.0],[1263.0,199.0]]},{"block_label":"text","block_content":"又如黄天树著《殷墟王卜辞的分类与断代》，该书从字形上确立了王卜辞分组分类的基本标准，但是，从书法用笔的角度，该书摹文并没有体现出不同组、类之间的差异，罔论甲骨文字的精神风貌。如该书第266页列举的无名黄间类和黄类的代表字形：","block_bbox":[211,228,1303,352],"block_id":3,"block_order":1,"group_id":3,"block_polygon_points":[[211.0,228.0],[1303.0,228.0],[1303.0,352.0],[211.0,352.0]]},{"block_label":"table","block_content":"\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td style='text-align: center; word-wrap: break-word;'>无名黄间类</td><td style='text-align: center; word-wrap: break-word;'>浅</td><td style='text-align: center; word-wrap: break-word;'>名</td><td style='text-align: center; word-wrap: break-word;'>予</td><td style='text-align: center; word-wrap: break-word;'>徂</td><td style='text-align: center; word-wrap: break-word;'>酉</td><td style='text-align: center; word-wrap: break-word;'>甥</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>黄</td><td style='text-align: center; word-wrap: break-word;'>类</td><td style='text-align: center; word-wrap: break-word;'>浅</td><td style='text-align: center; word-wrap: break-word;'>乞</td><td style='text-align: center; word-wrap: break-word;'>予</td><td style='text-align: center; word-wrap: break-word;'>徂</td><td style='text-align: center; word-wrap: break-word;'>晋</td></tr></table>","block_bbox":[217,390,1297,583],"block_id":4,"group_id":4,"block_polygon_points":[[217.0,390.0],[1297.0,390.0],[1297.0,583.0],[217.0,583.0]]},{"block_label":"vision_footnote","block_content":"图三《殷墟王卜辞的分类与断代》16页图2-19","block_bbox":[214,603,567,627],"block_id":5,"group_id":5,"block_polygon_points":[[214.0,603.0],[567.0,603.0],[567.0,627.0],[214.0,627.0]]},{"block_label":"text","block_content":"字形上可以看出，两类的字形构成确有不同，但从用笔上讲求，两类的摹文其实别无二致。","block_bbox":[212,687,974,765],"block_id":6,"block_order":2,"group_id":6,"block_polygon_points":[[212.0,687.0],[974.0,687.0],[974.0,765.0],[212.0,765.0]]},{"block_label":"text","block_content":"大体上，这些摹文只是用呆板的线条将字形结构摹写出来，其直接后果是导致甲骨上的自然纹路、兆纹、界划线与刻辞笔道在摹文中无法区分，如该书第 16 页图 2-19：","block_bbox":[212,780,972,904],"block_id":7,"block_order":3,"group_id":7,"block_polygon_points":[[212.0,780.0],[972.0,780.0],[972.0,904.0],[212.0,904.0]]},{"block_label":"text","block_content":"对于熟悉甲骨的研究者，摹文中甲骨的边线、盾纹、兆纹及界划线或许是一目了然，但是，从书法的角度，这些痕迹与卜辞笔画是混淆的。笔画的书写性并没有凸显出来。","block_bbox":[211,964,976,1088],"block_id":8,"block_order":4,"group_id":8,"block_polygon_points":[[211.0,964.0],[976.0,964.0],[976.0,1088.0],[211.0,1088.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1030_688_1298_1004.jpg\" alt=\"Image\" width=\"17%\" /></div>\n","block_bbox":[1030,688,1298,1004],"block_id":9,"group_id":9,"block_polygon_points":[[1030.0,688.0],[1298.0,688.0],[1298.0,1004.0],[1030.0,1004.0]]},{"block_label":"figure_title","block_content":"<div style=\"text-align: center;\">图二《殷墟王卜辞的分类与断代》266页图</div>\n","block_bbox":[1031,1027,1285,1075],"block_id":10,"group_id":10,"block_polygon_points":[[1031.0,1027.0],[1285.0,1027.0],[1285.0,1075.0],[1031.0,1075.0]]},{"block_label":"text","block_content":"总之，在出版书籍中对甲骨文粗糙的摹写，会直接导致学者们对甲骨原有的风采丧失判断力。而没有实物或高清影像为参考，很难想象能摹写出精确无误的甲骨文。单纯根据经验判断字形，缺乏科学依据。","block_bbox":[212,1102,1304,1179],"block_id":11,"block_order":5,"group_id":11,"block_polygon_points":[[212.0,1102.0],[1304.0,1102.0],[1304.0,1179.0],[212.0,1179.0]]},{"block_label":"text","block_content":"基于此，故宫博物院藏殷墟甲骨文的摹写有高清的影像、精致的原拓作为直接参考，若仍有模糊不清之处，则提取甲骨原物，仔细观察修正。","block_bbox":[211,1194,1303,1272],"block_id":12,"block_order":6,"group_id":12,"block_polygon_points":[[211.0,1194.0],[1303.0,1194.0],[1303.0,1272.0],[211.0,1272.0]]},{"block_label":"text","block_content":"在具体摹写上，我们深入研究了甲骨卜辞的每一种风格。甲骨文的字体风格十分复杂。众所周知，目前对甲骨文的分类，或是通过贞人系联出不同的“组”，或是根据字体区分出不同的“类”。实际上，由于贞人和契刻者各有专职，即使是同一贞人的卜辞，其字体也可能有差别。对于甲骨的契刻者，他们的用笔、结构、布局都表现在自己的作品中。其书写特点和构图方式，或是平和肃穆，或是动荡不安，或复杂，或简洁。另外，在甲骨文中，还包括一些练习者的作品。大多数是单字的重复、甲子表或临写卜辞。笔划稚拙生涩，布局刻板单调，与成熟面貌的卜辞完全不同。总体来看，当时对甲骨文的刻写要求比较严格，并不是单纯地用文字来记录占卜内容，而是还有着契刻者的审美和情感。因此，契刻者对甲骨文的形式美有着较高的要求，而甲骨文空间结构的好坏，决定字的品格高低。","block_bbox":[210,1285,1305,1642],"block_id":13,"block_order":7,"group_id":13,"block_polygon_points":[[210.0,1285.0],[1305.0,1285.0],[1305.0,1642.0],[210.0,1642.0]]},{"block_label":"footnote","block_content":"黄天树：《殷墟王卜辞的分类与断代》，科学出版社，2007年。","block_bbox":[213,1708,705,1736],"block_id":14,"group_id":14,"block_polygon_points":[[213.0,1708.0],[705.0,1708.0],[705.0,1736.0],[213.0,1736.0]]},{"block_label":"footer","block_content":"DA21010107-焦东华-CC2017.indd 77","block_bbox":[89,1919,311,1940],"block_id":15,"group_id":15,"block_polygon_points":[[89.0,1919.0],[310.0,1919.0],[310.0,1939.0],[89.0,1939.0]]},{"block_label":"number","block_content":"⊕","block_bbox":[756,1916,782,1944],"block_id":16,"group_id":16,"block_polygon_points":[[756.0,1916.0],[781.0,1916.0],[781.0,1943.0],[756.0,1943.0]]},{"block_label":"footer","block_content":"2021/1/20 下午5:15","block_bbox":[1341,1917,1460,1941],"block_id":17,"group_id":17,"block_polygon_points":[[1341.0,1917.0],[1460.0,1917.0],[1460.0,1941.0],[1341.0,1941.0]]}],"layout_det_res":{"boxes":[{"cls_id":13,"label":"header_image","score":0.3698570430278778,"coordinate":[752,15,784,47],"polygon_points":[[752.0,15.0],[783.0,15.0],[783.0,46.0],[752.0,46.0]]},{"cls_id":12,"label":"header","score":0.6992605328559875,"coordinate":[1164,180,1233,203],"polygon_points":[[1164.0,180.0],[1232.0,180.0],[1232.0,202.0],[1164.0,202.0]]},{"cls_id":16,"label":"number","score":0.6622838377952576,"coordinate":[1263,177,1301,200],"order":1,"polygon_points":[[1263.0,177.0],[1300.0,177.0],[1300.0,199.0],[1263.0,199.0]]},{"cls_id":22,"label":"text","score":0.9282616972923279,"coordinate":[211,228,1303,352],"order":2,"polygon_points":[[211.0,228.0],[1303.0,228.0],[1303.0,352.0],[211.0,352.0]]},{"cls_id":21,"label":"table","score":0.9268122315406799,"coordinate":[217,390,1297,583],"polygon_points":[[217.0,390.0],[1297.0,390.0],[1297.0,583.0],[217.0,583.0]]},{"cls_id":24,"label":"vision_footnote","score":0.5885602235794067,"coordinate":[214,603,567,627],"polygon_points":[[214.0,603.0],[567.0,603.0],[567.0,627.0],[214.0,627.0]]},{"cls_id":22,"label":"text","score":0.9128888845443726,"coordinate":[212,687,974,765],"order":3,"polygon_points":[[212.0,687.0],[974.0,687.0],[974.0,765.0],[212.0,765.0]]},{"cls_id":22,"label":"text","score":0.9362266063690186,"coordinate":[212,780,972,904],"order":4,"polygon_points":[[212.0,780.0],[972.0,780.0],[972.0,904.0],[212.0,904.0]]},{"cls_id":22,"label":"text","score":0.9352853298187256,"coordinate":[211,964,976,1088],"order":5,"polygon_points":[[211.0,964.0],[976.0,964.0],[976.0,1088.0],[211.0,1088.0]]},{"cls_id":14,"label":"image","score":0.9427995681762695,"coordinate":[1030,688,1298,1004],"polygon_points":[[1030.0,688.0],[1298.0,688.0],[1298.0,1004.0],[1030.0,1004.0]]},{"cls_id":7,"label":"figure_title","score":0.8269121646881104,"coordinate":[1031,1027,1285,1075],"polygon_points":[[1031.0,1027.0],[1285.0,1027.0],[1285.0,1075.0],[1031.0,1075.0]]},{"cls_id":22,"label":"text","score":0.9254060983657837,"coordinate":[212,1102,1304,1179],"order":6,"polygon_points":[[212.0,1102.0],[1304.0,1102.0],[1304.0,1179.0],[212.0,1179.0]]},{"cls_id":22,"label":"text","score":0.9252013564109802,"coordinate":[211,1194,1303,1272],"order":7,"polygon_points":[[211.0,1194.0],[1303.0,1194.0],[1303.0,1272.0],[211.0,1272.0]]},{"cls_id":22,"label":"text","score":0.9643763303756714,"coordinate":[210,1285,1305,1642],"order":8,"polygon_points":[[210.0,1285.0],[1305.0,1285.0],[1305.0,1642.0],[210.0,1642.0]]},{"cls_id":10,"label":"footnote","score":0.8717107772827148,"coordinate":[213,1708,705,1736],"polygon_points":[[213.0,1708.0],[705.0,1708.0],[705.0,1736.0],[213.0,1736.0]]},{"cls_id":8,"label":"footer","score":0.7814692854881287,"coordinate":[89,1919,311,1940],"polygon_points":[[89.0,1919.0],[310.0,1919.0],[310.0,1939.0],[89.0,1939.0]]},{"cls_id":16,"label":"number","score":0.5262561440467834,"coordinate":[756,1916,782,1944],"order":9,"polygon_points":[[756.0,1916.0],[781.0,1916.0],[781.0,1943.0],[756.0,1943.0]]},{"cls_id":8,"label":"footer","score":0.7447916865348816,"coordinate":[1341,1917,1460,1941],"polygon_points":[[1341.0,1917.0],[1460.0,1917.0],[1460.0,1941.0],[1341.0,1941.0]]}]}},"markdown":{"text":"又如黄天树著《殷墟王卜辞的分类与断代》，该书从字形上确立了王卜辞分组分类的基本标准，但是，从书法用笔的角度，该书摹文并没有体现出不同组、类之间的差异，罔论甲骨文字的精神风貌。如该书第266页列举的无名黄间类和黄类的代表字形：\n\n\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td style='text-align: center; word-wrap: break-word;'>无名黄间类</td><td style='text-align: center; word-wrap: break-word;'>浅</td><td style='text-align: center; word-wrap: break-word;'>名</td><td style='text-align: center; word-wrap: break-word;'>予</td><td style='text-align: center; word-wrap: break-word;'>徂</td><td style='text-align: center; word-wrap: break-word;'>酉</td><td style='text-align: center; word-wrap: break-word;'>甥</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>黄</td><td style='text-align: center; word-wrap: break-word;'>类</td><td style='text-align: center; word-wrap: break-word;'>浅</td><td style='text-align: center; word-wrap: break-word;'>乞</td><td style='text-align: center; word-wrap: break-word;'>予</td><td style='text-align: center; word-wrap: break-word;'>徂</td><td style='text-align: center; word-wrap: break-word;'>晋</td></tr></table>\n\n图三《殷墟王卜辞的分类与断代》16页图2-19\n\n字形上可以看出，两类的字形构成确有不同，但从用笔上讲求，两类的摹文其实别无二致。\n\n大体上，这些摹文只是用呆板的线条将字形结构摹写出来，其直接后果是导致甲骨上的自然纹路、兆纹、界划线与刻辞笔道在摹文中无法区分，如该书第 16 页图 2-19：\n\n对于熟悉甲骨的研究者，摹文中甲骨的边线、盾纹、兆纹及界划线或许是一目了然，但是，从书法的角度，这些痕迹与卜辞笔画是混淆的。笔画的书写性并没有凸显出来。\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1030_688_1298_1004.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n<div style=\"text-align: center;\">图二《殷墟王卜辞的分类与断代》266页图</div>\n\n\n总之，在出版书籍中对甲骨文粗糙的摹写，会直接导致学者们对甲骨原有的风采丧失判断力。而没有实物或高清影像为参考，很难想象能摹写出精确无误的甲骨文。单纯根据经验判断字形，缺乏科学依据。\n\n基于此，故宫博物院藏殷墟甲骨文的摹写有高清的影像、精致的原拓作为直接参考，若仍有模糊不清之处，则提取甲骨原物，仔细观察修正。\n\n在具体摹写上，我们深入研究了甲骨卜辞的每一种风格。甲骨文的字体风格十分复杂。众所周知，目前对甲骨文的分类，或是通过贞人系联出不同的“组”，或是根据字体区分出不同的“类”。实际上，由于贞人和契刻者各有专职，即使是同一贞人的卜辞，其字体也可能有差别。对于甲骨的契刻者，他们的用笔、结构、布局都表现在自己的作品中。其书写特点和构图方式，或是平和肃穆，或是动荡不安，或复杂，或简洁。另外，在甲骨文中，还包括一些练习者的作品。大多数是单字的重复、甲子表或临写卜辞。笔划稚拙生涩，布局刻板单调，与成熟面貌的卜辞完全不同。总体来看，当时对甲骨文的刻写要求比较严格，并不是单纯地用文字来记录占卜内容，而是还有着契刻者的审美和情感。因此，契刻者对甲骨文的形式美有着较高的要求，而甲骨文空间结构的好坏，决定字的品格高低。","images":{"imgs/img_in_header_image_box_752_15_784_47.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//309a37fe-a002-4632-945f-08a30cb64d39/markdown_0/imgs/img_in_header_image_box_752_15_784_47.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A28%3A43Z%2F-1%2F%2F7fa2b1f7fbf4578ff5ce9d4ef18a9c5cb450f92fef1fc28076ce2448b68b9f2e","imgs/img_in_image_box_1030_688_1298_1004.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//309a37fe-a002-4632-945f-08a30cb64d39/markdown_0/imgs/img_in_image_box_1030_688_1298_1004.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A28%3A43Z%2F-1%2F%2F20dab48193506d9a2aa200780e923767e6aecd9d32c0f87110dcbefad3b77007"}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//309a37fe-a002-4632-945f-08a30cb64d39/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A28%3A43Z%2F-1%2F%2Fde2460c9e1df6790ef60dba39058d8953063c44bb9b98cb2326226f5d60c9f5b"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//309a37fe-a002-4632-945f-08a30cb64d39/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A28%3A43Z%2F-1%2F%2F1b100c1c9f01b405be69b7a09e0a4b143c60caecf49a2cd12acfb735d7e4c0a3"}]