1376.0],[756.0,1376.0],[756.0,1409.0],[263.0,1409.0]]},{"cls_id":14,"label":"image","score":0.9098215103149414,"coordinate":[739,416,983,852],"polygon_points":[[739.0,416.0],[983.0,416.0],[983.0,852.0],[739.0,852.0]]},{"cls_id":7,"label":"figure_title","score":0.678928554058075,"coordinate":[1020,373,1136,398],"polygon_points":[[1020.0,373.0],[1136.0,373.0],[1136.0,398.0],[1020.0,398.0]]},{"cls_id":14,"label":"image","score":0.8629051446914673,"coordinate":[1025,409,1269,849],"polygon_points":[[1025.0,409.0],[1269.0,409.0],[1269.0,849.0],[1025.0,849.0]]},{"cls_id":7,"label":"figure_title","score":0.4460006058216095,"coordinate":[729,909,857,932],"polygon_points":[[729.0,909.0],[856.0,909.0],[856.0,931.0],[729.0,931.0]]},{"cls_id":7,"label":"figure_title","score":0.562565267086029,"coordinate":[1020,906,1151,930],"polygon_points":[[1020.0,906.0],[1151.0,906.0],[1151.0,930.0],[1020.0,930.0]]},{"cls_id":14,"label":"image","score":0.9298809170722961,"coordinate":[732,947,983,1328],"polygon_points":[[732.0,947.0],[983.0,947.0],[983.0,1328.0],[732.0,1328.0]]},{"cls_id":14,"label":"image","score":0.9290170669555664,"coordinate":[1013,946,1264,1313],"polygon_points":[[1013.0,946.0],[1264.0,946.0],[1264.0,1313.0],[1013.0,1313.0]]},{"cls_id":22,"label":"text","score":0.7942753434181213,"coordinate":[153,1455,1276,1516],"order":18,"polygon_points":[[153.0,1455.0],[1276.0,1455.0],[1276.0,1516.0],[153.0,1516.0]]},{"cls_id":22,"label":"text","score":0.5861154198646545,"coordinate":[185,1531,1172,1559],"order":19,"polygon_points":[[185.0,1531.0],[1172.0,1531.0],[1172.0,1559.0],[185.0,1559.0]]},{"cls_id":22,"label":"text","score":0.711331307888031,"coordinate":[154,1577,1276,1639],"order":20,"polygon_points":[[154.0,1577.0],[1276.0,1577.0],[1276.0,1639.0],[154.0,1639.0]]},{"cls_id":8,"label":"footer","score":0.8448495864868164,"coordinate":[653,1727,1157,1752],"polygon_points":[[653.0,1727.0],[1157.0,1727.0],[1157.0,1752.0],[653.0,1752.0]]},{"cls_id":16,"label":"number","score":0.7446975708007812,"coordinate":[1232,1733,1273,1755],"order":21,"polygon_points":[[1232.0,1733.0],[1272.0,1733.0],[1272.0,1754.0],[1232.0,1754.0]]}]}},"markdown":{"text":"下文中，故宫博物院藏甲骨编号皆为“新xxxxx”，“新”代表1945年后入藏的文物，下文提到《甲骨文合集》片号的释文时采取《殷墟甲骨文刻辞摹释总集》的说法，如遇《殷墟甲骨文刻辞摹释总集校订》修正的情况下，采用《摹校》的释文，并出注说明 $ ^{①} $，凡故宫博物院藏文物编号所作甲骨释文则为笔者所释读。\n\n## (一)《合》25581=新68799\n\n(1) 乙酉卜行贞，王宾禧亡囚，在…。\n\n贞…。\n\n(《合》25581，〔图一〕)\n\n(2) …十二月。\n\n乙酉卜，行贞，王室裨亡囚，才\n\n(在)十二月。\n\n寘。\n\n贞…。（新68799，出组二类，\n\n〔图二〕）\n\n从图二可清楚地发现骨版右侧断裂边缘的文字为“十二月”，《合集》拓本模糊不清，导致《摹释》一书中未能释出“十二月”，连带牛骨上端的“十二月”残辞亦未释出。然胡厚宣在《甲骨文合集释文》中将此条释为“乙酉卜，行，贞王宾福亡囚，在十月” $ ^{2} $。虽已注意到四字后面有记月，但仍未能全释。\n\n## (二)《合》5290=新74642\n\n(1) …无延…燕…惟若…。\n\n（《合》5290，〔图三〕）\n\n(2) …亡征（延） $ ^{3} $…燕…隹（惟）\n\n<div style=\"text-align: center;\">[图一]《合》25581</div>\n\n\n若…又…。(新74642正，宾组二类，〔图四〕)\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_739_416_983_852.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n<div style=\"text-align: center;\">[图二]新68799</div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1025_409_1269_849.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n<div style=\"text-align: center;\">〔图三〕《合》5290</div>\n\n\n<div style=\"text-align: center;\">[图四]新74642正</div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_732_947_983_1328.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1013_946_1264_1313.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n〈1〉本文中《甲骨文合集》简称《合》或《合集》，《殷墟甲骨刻辞摹释总集》简称《摹释》，《殷墟甲骨刻辞摹释总集校订》简称《摹校》。以下皆同，不再重复出注。\n\n<2> 胡厚宣主编：《甲骨文合集释文》页1273，中国社会科学出版社，1999年。本文在引用他人隶定的释文时，照原文迻录。\n\n〈3〉 “征”(延)为继续、接着的意思，表示两事先后相继的关系。张金玉：《卜辞中表示两事时间关系的词的意义和用法》，《文物研究》第9辑，页187－191，黄山书社，1994年。","images":{"imgs/img_in_image_box_739_416_983_852.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/markdown_0/imgs/img_in_image_box_739_416_983_852.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2F90bb062fb91ccecc9f8f54cb96ae6b03327f8d17e0e6acd1a1e17bfc65b43b82","imgs/img_in_image_box_1025_409_1269_849.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/markdown_0/imgs/img_in_image_box_1025_409_1269_849.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2F3776b7512d2316821b5bc09572d1571dca19a179f2c34a9798b54a944340a8c4","imgs/img_in_image_box_732_947_983_1328.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/markdown_0/imgs/img_in_image_box_732_947_983_1328.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2F92d77ee028f958d892d12f2400592f0c0118f7dc22d9f6332e576e85c4162fd5","imgs/img_in_image_box_1013_946_1264_1313.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/markdown_0/imgs/img_in_image_box_1013_946_1264_1313.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2Fce378dde1c49bbb1d61f3ff56db5475c8f4d0d9742259fe0380875b799a7ae3d"}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2F3d1ef0584e3e1438ae81d250647c6be04c31eeb2dc33a011261d35bc40ad09dc"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-15//cc67ddb7-63f2-46f3-b9ea-bb534e969d16/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-05-18T02%3A27%3A46Z%2F-1%2F%2F861b5a0e306dfbb88893479c57a1e516fd7cd39b0c9a5420389cde4b7606a6d4"}]