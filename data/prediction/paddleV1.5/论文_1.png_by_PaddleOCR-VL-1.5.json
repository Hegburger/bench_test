[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"下文中，故宫博物院藏甲骨编号皆为“新xxxxx”，“新”代表1945年后入藏的文物，下文提到《甲骨文合集》片号的释文时采取《殷墟甲骨文刻辞摹释总集》的说法，如遇《殷墟甲骨文刻辞摹释总集校订》修正的情况下，采用《摹校》的释文，并出注说明 $ ^{①} $，凡故宫博物院藏文物编号所作甲骨释文则为笔者所释读。","block_bbox":[150,180,1278,307],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[150.0,180.0],[1278.0,180.0],[1278.0,307.0],[150.0,307.0]]},{"block_label":"paragraph_title","block_content":"## (一)《合》25581=新68799","block_bbox":[201,364,465,396],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[201.0,364.0],[465.0,364.0],[465.0,396.0],[201.0,396.0]]},{"block_label":"text","block_content":"(1) 乙酉卜行贞，王宾禧亡囚，在…。\n\n贞…。","block_bbox":[262,410,652,492],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[262.0,410.0],[652.0,410.0],[652.0,492.0],[262.0,492.0]]},{"block_label":"text","block_content":"(《合》25581，〔图一〕)","block_bbox":[310,492,649,542],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[310.0,492.0],[649.0,492.0],[649.0,542.0],[310.0,542.0]]},{"block_label":"text","block_content":"(2) …十二月。\n\n乙酉卜，行贞，王室裨亡囚，才\n\n(在)十二月。","block_bbox":[260,549,647,665],"block_id":4,"block_order":5,"group_id":4,"block_polygon_points":[[260.0,549.0],[647.0,549.0],[647.0,665.0],[260.0,665.0]]},{"block_label":"text","block_content":"寘。","block_bbox":[311,687,350,719],"block_id":5,"block_order":6,"group_id":5,"block_polygon_points":[[311.0,687.0],[349.0,687.0],[349.0,718.0],[311.0,718.0]]},{"block_label":"text","block_content":"贞…。（新68799，出组二类，\n\n〔图二〕）","block_bbox":[311,732,670,811],"block_id":6,"block_order":7,"group_id":6,"block_polygon_points":[[311.0,732.0],[670.0,732.0],[670.0,811.0],[311.0,811.0]]},{"block_label":"text","block_content":"从图二可清楚地发现骨版右侧断裂边缘的文字为“十二月”，《合集》拓本模糊不清，导致《摹释》一书中未能释出“十二月”，连带牛骨上端的“十二月”残辞亦未释出。然胡厚宣在《甲骨文合集释文》中将此条释为“乙酉卜，行，贞王宾福亡囚，在十月” $ ^{2} $。虽已注意到四字后面有记月，但仍未能全释。","block_bbox":[150,824,685,1135],"block_id":7,"block_order":8,"group_id":7,"block_polygon_points":[[150.0,824.0],[685.0,824.0],[685.0,1135.0],[150.0,1135.0]]},{"block_label":"paragraph_title","block_content":"## (二)《合》5290=新74642","block_bbox":[202,1192,453,1224],"block_id":8,"block_order":9,"group_id":8,"block_polygon_points":[[202.0,1192.0],[453.0,1192.0],[453.0,1224.0],[202.0,1224.0]]},{"block_label":"text","block_content":"(1) …无延…燕…惟若…。\n\n（《合》5290，〔图三〕）","block_bbox":[261,1238,583,1318],"block_id":9,"block_order":10,"group_id":9,"block_polygon_points":[[261.0,1238.0],[583.0,1238.0],[583.0,1318.0],[261.0,1318.0]]},{"block_label":"text","block_content":"(2) …亡征（延） $ ^{3} $…燕…隹（惟）","block_bbox":[261,1328,625,1363],"block_id":10,"block_order":11,"group_id":10,"block_polygon_points":[[261.0,1328.0],[625.0,1328.0],[625.0,1363.0],[261.0,1363.0]]},{"block_label":"figure_title","block_content":"<div style=\"text-align: center;\">[图一]《合》25581</div>\n","block_bbox":[728,374,866,398],"block_id":11,"group_id":11,"block_polygon_points":[[728.0,374.0],[866.0,374.0],[866.0,398.0],[728.0,398.0]]},{"block_label":"text","block_content":"若…又…。(新74642正，宾组二类，〔图四〕)","block_bbox":[263,1376,756,1409],"block_id":12,"block_order":12,"group_id":12,"block_polygon_points":[[263.0,1376.0],[756.0,1376.0],[756.0,1409.0],[263.0,1409.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_739_416_983_852.jpg\" alt=\"Image\" width=\"17%\" /></div>\n","block_bbox":[739,416,983,852],"block_id":13,"group_id":13,"block_polygon_points":[[739.0,416.0],[983.0,416.0],[983.0,852.0],[739.0,852.0]]},{"block_label":"figure_title","block_content":"<div style=\"text-align: center;\">[图二]新68799</div>\n","block_bbox":[1020,373,1136,398],"block_id":14,"group_id":14,"block_polygon_points":[[1020.0,373.0],[1136.0,373.0],[1136.0,398.0],[1020.0,398.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1025_409_1269_849.jpg\" alt=\"Image\" width=\"17%\" /></div>\n","block_bbox":[1025,409,1269,849],"block_id":15,"group_id":15,"block_polygon_points":[[1025.0,409.0],[1269.0,409.0],[1269.0,849.0],[1025.0,849.0]]},{"block_label":"figure_title","block_content":"<div style=\"text-align: center;\">〔图三〕《合》5290</div>\n","block_bbox":[729,909,857,932],"block_id":16,"group_id":16,"block_polygon_points":[[729.0,909.0],[856.0,909.0],[856.0,931.0],[729.0,931.0]]},{"block_label":"figure_title","block_content":"<div style=\"text-align: center;\">[图四]新74642正</div>\n","block_bbox":[1020,906,1151,930],"block_id":17,"group_id":17,"block_polygon_points":[[1020.0,906.0],[1151.0,906.0],[1151.0,930.0],[1020.0,930.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_732_947_983_1328.jpg\" alt=\"Image\" width=\"17%\" /></div>\n","block_bbox":[732,947,983,1328],"block_id":18,"group_id":18,"block_polygon_points":[[732.0,947.0],[983.0,947.0],[983.0,1328.0],[732.0,1328.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1013_946_1264_1313.jpg\" alt=\"Image\" width=\"17%\" /></div>\n","block_bbox":[1013,946,1264,1313],"block_id":19,"group_id":19,"block_polygon_points":[[1013.0,946.0],[1264.0,946.0],[1264.0,1313.0],[1013.0,1313.0]]},{"block_label":"text","block_content":"〈1〉本文中《甲骨文合集》简称《合》或《合集》，《殷墟甲骨刻辞摹释总集》简称《摹释》，《殷墟甲骨刻辞摹释总集校订》简称《摹校》。以下皆同，不再重复出注。","block_bbox":[153,1455,1276,1516],"block_id":20,"block_order":13,"group_id":20,"block_polygon_points":[[153.0,1455.0],[1276.0,1455.0],[1276.0,1516.0],[153.0,1516.0]]},{"block_label":"text","block_content":"<2> 胡厚宣主编：《甲骨文合集释文》页1273，中国社会科学出版社，1999年。本文在引用他人隶定的释文时，照原文迻录。","block_bbox":[185,1531,1172,1559],"block_id":21,"block_order":14,"group_id":21,"block_polygon_points":[[185.0,1531.0],[1172.0,1531.0],[1172.0,1559.0],[185.0,1559.0]]},{"block_label":"text","block_content":"〈3〉 “征”(延)为继续、接着的意思，表示两事先后相继的关系。张金玉：《卜辞中表示两事时间关系的词的意义和用法》，《文物研究》第9辑，页187－191，黄山书社，1994年。","block_bbox":[154,1577,1276,1639],"block_id":22,"block_order":15,"group_id":22,"block_polygon_points":[[154.0,1577.0],[1276.0,1577.0],[1276.0,1639.0],[154.0,1639.0]]},{"block_label":"footer","block_content":"据故宫博物院藏甲骨勘定《甲骨文合集》等著录释文脱讹举隅","block_bbox":[653,1727,1157,1752],"block_id":23,"group_id":23,"block_polygon_points":[[653.0,1727.0],[1157.0,1727.0],[1157.0,1752.0],[653.0,1752.0]]},{"block_label":"number","block_content":"013","block_bbox":[1232,1733,1273,1755],"block_id":24,"group_id":24,"block_polygon_points":[[1232.0,1733.0],[1272.0,1733.0],[1272.0,1754.0],[1232.0,1754.0]]}],"layout_det_res":{"boxes":[{"cls_id":22,"label":"text","score":0.939681351184845,"coordinate":[150,180,1278,307],"order":1,"polygon_points":[[150.0,180.0],[1278.0,180.0],[1278.0,307.0],[150.0,307.0]]},{"cls_id":17,"label":"paragraph_title","score":0.815601646900177,"coordinate":[201,364,465,396],"order":2,"polygon_points":[[201.0,364.0],[465.0,364.0],[465.0,396.0],[201.0,396.0]]},{"cls_id":22,"label":"text","score":0.730873167514801,"coordinate":[262,410,652,492],"order":3,"polygon_points":[[262.0,410.0],[652.0,410.0],[652.0,492.0],[262.0,492.0]]},{"cls_id":22,"label":"text","score":0.6082785725593567,"coordinate":[310,492,649,542],"order":4,"polygon_points":[[310.0,492.0],[649.0,492.0],[649.0,542.0],[310.0,542.0]]},{"cls_id":22,"label":"text","score":0.3444485068321228,"coordinate":[262,548,422,581],"order":5,"polygon_points":[[262.0,548.0],[422.0,548.0],[422.0,581.0],[262.0,581.0]]},{"cls_id":22,"label":"text","score":0.3011568784713745,"coordinate":[260,549,647,665],"order":6,"polygon_points":[[260.0,549.0],[647.0,549.0],[647.0,665.0],[260.0,665.0]]},{"cls_id":22,"label":"text","score":0.37850773334503174,"coordinat